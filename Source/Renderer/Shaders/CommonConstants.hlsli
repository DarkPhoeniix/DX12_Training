
#ifndef __COMMON_CONSTANTS_HLSL__
#define __COMMON_CONSTANTS_HLSL__

const static float k_PI = 3.1415926535897f;
const static float k_2_PI = 2.0f * k_PI;
const static float k_PI_2 = k_PI * 0.5f;
const static float k_PI_4 = k_PI * 0.25f;
const static float k_1_PI = 1.0f / k_PI;
const static float k_1_PI_2 = k_1_PI * 0.5f;

#endif // __COMMON_CONSTANTS_HLSL__

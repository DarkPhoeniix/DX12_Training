{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 29
    },
    "configurePresets": [
        {
            "name": "Base-x64",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BIN_DIR": "${sourceDir}/Bin",
                "EXE_DIR":  "${sourceDir}/Bin/${presetName}",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/Bin/${presetName}/Libs",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/Bin/${presetName}/Libs",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/Bin/${presetName}"
            }
        },
        {
            "name": "Debug-x64",
            "inherits": "Base-x64",
            "displayName": "Debug (x64)",
            "description": "Build with debug information and no optimizations",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "/D_DEBUG"
            }
        },
        {
            "name": "Profile-x64",
            "inherits": "Base-x64",
            "displayName": "Profile (x64)",
            "description": "Build with profiling flags enabled",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Profile",
                "CMAKE_CXX_FLAGS_PROFILE": "/DPROFILE"
            }
        },
        {
            "name": "Release-x64",
            "inherits": "Base-x64",
            "displayName": "Release (x64)",
            "description": "Optimized release build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug-x64",
            "configurePreset": "Debug-x64"
        },
        {
            "name": "Profile-x64",
            "configurePreset": "Profile-x64"
        },
        {
            "name": "Release-x64",
            "configurePreset": "Release-x64"
        }
    ]
}
